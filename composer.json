{
    "name": "archlinux-de/forum.archlinux.de",
    "description": "The German Arch Linux forum",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-exif": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "archlinux-de/flarum-anti-spam": "dev-main",
        "archlinux-de/flarum-click-image": "dev-main",
        "archlinux-de/flarum-discussion-feed": "dev-main",
        "archlinux-de/flarum-redirect-fluxbb": "dev-main",
        "archlinux-de/flarum-redirect-ll": "dev-main",
        "archlinux-de/flarum-theme-archlinux": "dev-main",
        "flarum-lang/german": "^2.0.28",
        "flarum/approval": "^2.0.1",
        "flarum/bbcode": "^2.0.1",
        "flarum/core": "^2.0.2",
        "flarum/emoji": "^2.0.1",
        "flarum/flags": "^2.0.1",
        "flarum/gdpr": "^2.0.1",
        "flarum/lang-english": "^2.0.0",
        "flarum/likes": "^2.0.2",
        "flarum/lock": "^2.0.1",
        "flarum/markdown": "^2.0.1",
        "flarum/mentions": "^2.0.2",
        "flarum/messages": "^2.0.2",
        "flarum/nicknames": "^2.0.1",
        "flarum/sticky": "^2.0.2",
        "flarum/subscriptions": "^2.0.1",
        "flarum/suspend": "^2.0.2",
        "flarum/tags": "^2.0.2",
        "fof/anti-spam": "^2.0.1",
        "fof/formatting": "^2.0.0",
        "fof/merge-discussions": "^2.0.0-beta.4",
        "fof/sitemap": "^3.0.0",
        "fof/split": "^2.0.1",
        "fof/upload": "^2.0.3",
        "twemoji/flarum-assets": "^17.0.3"
    },
    "config": {
        "preferred-install": {
            "archlinux-de/*": "source",
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "malukenho/mcbumpface": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "malukenho/mcbumpface": "^1.2.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.4",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpunit/phpunit": "^12.5.42",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-intl-grapheme": "*",
        "symfony/polyfill-intl-idn": "*",
        "symfony/polyfill-intl-messageformatter": "*",
        "symfony/polyfill-intl-normalizer": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "extra": {
        "mc-bumpface": {
            "stripVersionPrefixes": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "twemoji/flarum-assets",
                "version": "17.0.3",
                "description": "Locally packaged upstream Twemoji image assets",
                "license": [
                    "MIT",
                    "CC-BY-4.0"
                ],
                "dist": {
                    "url": "https://codeload.github.com/jdecked/twemoji/tar.gz/refs/tags/v17.0.3",
                    "type": "tar",
                    "reference": "b6b55fef1e8636b540a6d016a4729ca8cdf2e60b",
                    "shasum": "8bfb317f9cf667e325dc8f8873906a594cfc8e83"
                },
                "type": "flarum-extension",
                "require": {
                    "flarum/emoji": "^2.0.1"
                },
                "extra": {
                    "flarum-extension": {
                        "title": "Local Twemoji Assets",
                        "category": "feature",
                        "icon": {
                            "name": "fas fa-smile",
                            "backgroundColor": "#FECC4D",
                            "color": "#664500"
                        }
                    }
                }
            }
        }
    ]
}
